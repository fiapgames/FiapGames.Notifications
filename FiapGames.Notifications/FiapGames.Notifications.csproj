<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>fiapgames-notifications</UserSecretsId>
        <AssemblyName>FiapGames.Notifications</AssemblyName>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1"/>
        <PackageReference Include="FiapGames.Contracts" Version="1.1.0"/>
        <PackageReference Include="NewRelic.Agent" Version="10.53.1"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2"/>
    </ItemGroup>

</Project>
